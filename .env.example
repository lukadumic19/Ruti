# Atlas Home – miljøvariabler
# Kopiér til .env.local og udfyld. .env.local er git-ignoreret og må ALDRIG commites.
# Alle variabler valideres med Zod ved opstart (src/config/env.ts fra Fase 1).
# Regler: docs/SECURITY_MODEL.md – hemmeligheder må ALDRIG hedde NEXT_PUBLIC_*.

# --- App-tilstand -------------------------------------------------------------
# "demo"  = mocktilstand uden Home Assistant (standard under udvikling)
# "live"  = rigtig Home Assistant-forbindelse (kræver HA_* nedenfor, fra Fase 3)
APP_MODE=demo

# --- Home Assistant (kun serverside/BFF – udelades helt i demo-tilstand) ------
# Basis-URL til dit Home Assistant på lokalnettet (uden afsluttende /)
HA_URL=http://homeassistant.local:8123
# WebSocket-URL (normalt samme vært: ws:// + /api/websocket)
HA_WS_URL=ws://homeassistant.local:8123/api/websocket
# Long-lived access token: HA → din profil → Sikkerhed → Langtidsgyldige tokens
HA_TOKEN=indsæt-dit-token-her

# --- App-server ---------------------------------------------------------------
# Hemmelighed til signering af session-cookies (generér: openssl rand -hex 32)
SESSION_SECRET=indsæt-tilfældig-hex-streng-her
# Mappe til appens egne data (curation, scener, babyhændelser) – git-ignoreret
DATA_DIR=./data

# --- Klient (må gerne være offentlige – ALDRIG hemmeligheder her) -------------
NEXT_PUBLIC_APP_ENV=development
